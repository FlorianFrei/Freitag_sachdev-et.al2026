library(tidyverse)
library(UpSetR)
Trialless <- read_csv("F:/Florian_paper/Florian/Aligned_Data/Analysable_data/wrangled_Data/R_outputs/Trialless.csv")
add_layers <- function(Data, depthpath) {
list_of_depth <- list.files(
path = depthpath,
pattern = "\\.csv$",
full.names = TRUE
)
depth <- read_csv(list_of_depth, id = "id", col_names = F)
depth <- depth %>%
mutate(id = str_extract(depth$id, "M\\d+_\\d+")) %>%
rename("surface" = X1)
Layerd <- Data %>%
separate_wider_delim(cluster_id2, delim = "_", names = c("del", "Mouse", "Day"), cols_remove = F) %>%
unite("id", c(Mouse, Day)) %>%
select(!del) %>%
left_join(depth) %>%
replace_na(list(surface = 950)) %>%
mutate(dist_surf = surface - depth) %>%
mutate(Layer_fine = case_when(
between(dist_surf, -500, -20) ~ "out",
between(dist_surf, -20, 50) ~ "L1",
between(dist_surf, 50, 500) ~ "L2/3",
between(dist_surf, 500, 750) ~ "L5A",
between(dist_surf, 750, 1050) ~ "L5B",
between(dist_surf, 1050, 1210) ~ "L6",
.default = "WTF"
)) %>%
mutate(Layer = case_when(
between(dist_surf, -500, -20) ~ "out",
between(dist_surf, -20, 500) ~ "L2/3",
between(dist_surf, 500, 1210) ~ "L5",
.default = "WTF"
))
Layerd
}
metapath <- "F:/Florian_paper/Florian/Aligned_Data/Analysable_data/meta"
list_of_meta <- list.files(
path = metapath,
pattern = "\\.tsv$",
full.names = TRUE
)
meta <- read_tsv(list_of_meta, id = "id2") %>%
as_tibble() %>%
select(id2, cluster_id, n_spikes, depth, group, fr)
meta <- meta %>% mutate(id = str_extract(meta$id2, "M\\d+_\\d+"))
# Peak_to_trough times from python script
list_of_ptt <- list.files(
path = "F:/Florian_paper/Florian/Aligned_Data/Analysable_data/peak_to_trough_times",
pattern = "\\.csv$",
full.names = TRUE
)
ptt <- read_csv(list_of_ptt, id = "id2") %>% as_tibble()
# keys to match the names of the Neruopixels data to the shortfrom M{id}_{session}
translator <- read_csv2("F:/Florian_paper/Florian/Aligned_Data/Analysable_data/translator.csv")
PTT_data <- Trialless %>%
left_join(meta %>% left_join(ptt %>% separate(Original_Index, into = c("old", "second_part"), sep = "(?=_row)", extra = "merge", remove = FALSE) %>%
left_join(translator) %>% select(second_part:new) %>% select(!Folder) %>% separate_wider_delim(second_part, delim = "_", names = c("d1", "d2", "cluster_id")) %>% select(cluster_id:new) %>% rename(id = new) %>%
mutate(cluster_id = as.numeric(cluster_id)) %>% filter(`Peak_to_Valley (ms)` > 0.16)) %>%
replace_na(list(`Peak_to_Valley (ms)` = 0)) %>% mutate(newgroup = ifelse(`Peak_to_Valley (ms)` == 0, group, "FS")) %>%
filter(group != "noise")) %>%
select(Behv:Zscore, newgroup, `Peak_to_Valley (ms)`) %>%
filter(newgroup != "noise")
Trialless <- add_layers(PTT_data, "F:/Florian_paper/Florian/Aligned_Data/Analysable_data/depths")
#combcont <- data.table::fread("F:/Florian_paper/Florian/Aligned_Data/Analysable_data/wrangled_Data/R_outputs/combcont.csv", showProgress = T)
datapath <- "F:/Florian_paper/Florian/Aligned_Data/Analysable_data/wrangled_Data/Zetatests"
list_of_data <- list.files(
path = datapath,
pattern = "\\.csv$",
full.names = T
)
Data <- read_csv(list_of_data, id = "Behv")
# extract id from filename, remove videos with more than 2 missing frames
Data <- Data %>%
mutate(Behv = str_extract(Behv, "(?<=/)[^/]+(?=\\.csv$)")) %>%
mutate(Behv = ifelse(Behv == "W2T", "HIT", Behv)) %>%
unite("unit", c(unit, Mouse, Day)) %>%
select(-`...1`)
Data <-Data %>% mutate(p_adj = p.adjust(p_val,method = "BH")) %>%  filter(p_adj < 0.05) %>% select(Behv,unit,p_adj)
upd <- Data %>%
mutate(it = 1) %>%
group_by(unit, Behv) %>%
summarise(it = max(it), .groups = "drop") %>% # Collapse duplicate rows
pivot_wider(names_from = Behv, values_from = it, values_fill = list(it = 0))
ups_plot <- upset(upd %>% as.data.frame(),
nsets = 6, order.by = "freq", number.angles = 10, point.size = 3.5, line.size = 2, cutoff = 5,
mainbar.y.label = "Response overlap", sets.x.label = "Units",
text.scale = c(4, 3, 3, 2, 4, 3)
)
ups_plot
# i saved this via the plots viewer pane as SVG
# Wide-format presence matrix
unit_behv_wide <- Data %>%
select(-p_adj) %>%
mutate(val = 1) %>%
pivot_wider(
names_from = Behv,
values_from = val,
values_fill = list(val = 0)
)
# Join unit-level behavior info to Trialless
Zeta_Trialless <- Trialless %>%
left_join(unit_behv_wide, by = c("cluster_id2" = "unit")) %>%
mutate(across(c(HIT, A2L, PC, Whisk), ~ replace_na(.x, 0))) %>%
mutate(res1 = case_when(
Behv == "A2L" & A2L == 1 ~ 1,
Behv == "PC" & PC == 1 ~ 1,
Behv == "W2T" & (HIT == 1 | Whisk == 1) ~ 1,
TRUE ~ 0
))
# duplicate data, to show average
Zeta_Trialless <- Zeta_Trialless %>% bind_rows(
Zeta_Trialless %>%
mutate(res1 = 2)
)
# plot
Plot_data <- Zeta_Trialless %>%
mutate(res1 = case_when(
res1 == 0 ~ "non responsive",
res1 == 1 ~ "responsive",
res1 == 2 ~ "average"
)) %>%
filter(between(rel_time, 0, 0.04)) %>%
group_by(Behv, res1, cluster_id2) %>%
slice_max(Zscore) %>%
group_by(Behv, res1) %>%
summarise(m = mean(Zscore), sd = sd(Zscore), sem = sd / sqrt(n()), low = quantile(Zscore, 0.75), high = quantile(Zscore, 0.25))
Plot_data %>% ggplot(aes(as.factor(res1), m, fill = as.factor(Behv))) +
geom_col(position = position_dodge()) +
geom_errorbar(aes(ymin = m - sem, ymax = m + sem), position = position_dodge()) +
theme_bw(base_size = 18) +
theme(
axis.line = element_line(color = "black"),
panel.grid = element_blank(),
panel.border = element_blank(),
strip.background = element_blank()
) +
xlab("Zeta outcome") +
ylab("Zscored FR") +
guides(fill = guide_legend(title = "Task")) +
coord_fixed(ratio = 0.6)
